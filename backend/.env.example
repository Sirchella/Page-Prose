# ── Campay Mobile Money ─────────────────────────────────────────────────────
# Get credentials at https://campay.net
CAMPAY_APP_USERNAME=your_campay_username_here
CAMPAY_APP_PASSWORD=your_campay_password_here

# Demo (testing, capped at 25 XAF) — switch to production URL when going live
CAMPAY_BASE_URL=https://demo.campay.net/api/
# CAMPAY_BASE_URL=https://www.campay.net/api/

# ── Django ───────────────────────────────────────────────────────────────────
# Set to True only for local development
DEBUG=False

# Comma-separated allowed hosts
# Local: localhost,127.0.0.1
# Production: localhost,127.0.0.1,your-backend-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated production frontend origins (leave empty for local only)
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Generate a strong secret key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-strong-random-key
